{
  "name": "fator-importacao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/ui.mjs",
    "prestart": "npm run gen",
    "start": "node src/server.js",
    "pretest": "npm run gen",
    "test": "node --test test/*.test.js",
    "prebuild": "npm run gen",
    "build": "bun build --compile --target=bun-windows-x64 src/server.js --outfile dist/fator-importacao.exe --windows-hide-console"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^4.10.38"
  },
  "description": "Consolida notas de debito e materiais de importacao em ConsolidadoPath.xlsx e calcula o fator de importacao."
}
